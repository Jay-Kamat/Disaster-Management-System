rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for security checks
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             getUserData().role == 'admin';
    }

    // --- Users collection rules ---
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Allow creation if the user is self-registering. 
      // Do not allow them to set their role to 'admin' unless they match specific trusted administrative emails.
      allow create: if isOwner(userId) && (
        request.resource.data.role == 'user' ||
        (request.resource.data.role == 'admin' && (
          request.auth.token.email == 'harshvardhankamat3708@gmail.com' ||
          request.auth.token.email == 'you@gmail.com' ||
          request.auth.token.email.matches('.*admin.*')
        ))
      );
      // Users can modify their own profile data but cannot elevate their role to admin.
      // Admins can update any user profile or role.
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isOwner(userId) && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) ||
          resource.data.role == request.resource.data.role
        ))
      );
      allow delete: if isAdmin();
    }

    // --- Reports collection rules ---
    match /reports/{reportId} {
      allow read: if true; // Public safety disaster reporting
      allow create: if isAuthenticated();
      // Only the author or an admin can update the report details.
      // Users cannot change the status or flags of the report (status must remain unchanged if not an admin).
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          resource.data.userId == request.auth.uid &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.flags == resource.data.flags
        )
      );
      allow delete: if isAdmin();
    }

    // --- Shelters collection rules ---
    match /shelters/{shelterId} {
      allow read: if true; // Public view for emergency shelters
      allow write: if isAdmin(); // Only admins can create/update/delete shelters
    }

    // --- RescueUnits collection rules ---
    match /rescueUnits/{unitId} {
      allow read: if true; // Public view for rescue coordinates
      allow write: if isAdmin(); // Only admins can create/update/delete units
    }

    // --- MissingPersons collection rules ---
    match /missingPersons/{personId} {
      allow read: if true; // Public view to find missing loved ones
      allow create: if isAuthenticated();
      // Allow update only if the user is the original reporter or an admin.
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          resource.data.userId == request.auth.uid ||
          (resource.data.userId == 'anonymous' && !('userId' in resource.data))
        )
      );
      allow delete: if isAdmin();
    }

    // --- Volunteers collection rules ---
    match /volunteers/{volunteerId} {
      allow read: if isAuthenticated(); // Authenticated users/admins can see volunteer list
      allow create: if isAuthenticated() && isOwner(volunteerId);
      // Users can modify or update their own volunteer settings
      allow update, delete: if isAuthenticated() && (isAdmin() || isOwner(volunteerId));
    }

    // --- EmergencyAlerts collection rules ---
    match /emergencyAlerts/{alertId} {
      allow read: if true; // Emergency notifications are public
      allow write: if isAdmin(); // Only admin panel can broadcast new alerts
    }

    // --- Donations collection rules (ledger) ---
    match /donations/{donationId} {
      allow read: if true; // Public transparency ledger
      allow create: if isAuthenticated(); // Any authenticated user can donate
      allow update, delete: if false; // Immutable ledger: once logged, cannot be changed
    }

  }
}
